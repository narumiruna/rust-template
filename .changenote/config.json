{
  "$schema": "https://raw.githubusercontent.com/changenote/changenote/main/schema.json",
  "base_branch": "origin/main",
  "changed_file_patterns": [
    "crates/cli/src/**",
    "crates/cli/Cargo.toml",
    "Cargo.toml",
    "Cargo.lock",
    "pyproject.toml",
    "uv.lock"
  ],
  "packages": {
    "rust-template": {
      "path": ".",
      "version_file": "crates/cli/Cargo.toml",
      "tag_prefix": "v"
    }
  }
}
