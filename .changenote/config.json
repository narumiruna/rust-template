{
  "$schema": "https://raw.githubusercontent.com/changenote/changenote/main/schema.json",
  "base_branch": "origin/main",
  "changed_file_patterns": [
    "src/**",
    "Cargo.toml",
    "Cargo.lock",
    "pyproject.toml",
    "uv.lock",
    ".github/workflows/release.yml"
  ],
  "packages": {
    "brachio": {
      "path": ".",
